# ---------------------------------------------------------------
# Copy this file to ".env" and fill in the real values.
# NEVER commit .env - it is git-ignored on purpose.
# ---------------------------------------------------------------

# --- Required: Groq LLM API key ---
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Required for OCR ---
# Full path to the Tesseract program.
# Windows default is shown. On Linux/macOS just use: tesseract
# If this path is wrong, the code falls back to whatever is on your PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Optional: where data lives ---
# Relative paths are resolved against the backend folder, not your
# current directory. Leave blank for the defaults.
DOCUMENTS_DIR=./data
CHROMA_PERSIST_DIR=./chroma_db

# --- Optional: OCR tuning ---
# OCR_LANG=eng
# OCR_DPI=300
# A page with fewer characters than this is treated as a scan and OCR'd.
# MIN_CHARS_PER_PAGE=200

# ---------------------------------------------------------------
# API security
# ---------------------------------------------------------------

# Front-end addresses allowed to call the API from a browser.
# Never set this to "*" - that lets any website on the internet make
# requests to this server using a visitor's browser.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Key required on the /api/ routes (recommend, upload, references).
# LEAVE BLANK for local development and those routes stay open.
# Set it and every request must send the same value in an X-API-Key header.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# POST /ingest writes directly into the vector store, and anything in
# there is later handed to the LLM as trusted source material. Keep it
# off unless you are actively using it.
INGEST_ENABLED=false
# Required when INGEST_ENABLED=true. Sent as the X-API-Key header.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=

# --- Size limits ---
# MAX_QUERY_CHARS=4000
# MAX_INGEST_DOCS=100
# MAX_INGEST_CHARS=50000

# --- Rate limit (per IP address) ---
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60


