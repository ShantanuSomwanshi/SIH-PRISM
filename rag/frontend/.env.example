# Copy this file to ".env" inside the frontend folder.
#
# Vite only exposes variables that start with VITE_, and everything it
# exposes is baked into the JavaScript the browser downloads. So this is
# NOT a secret - open developer tools on the page and you can read it.
#
# Leave it blank unless the backend has API_KEY set. It exists so the demo
# still works when the backend is locked down.
VITE_PRISM_API_KEY=
