.venv/
__pycache__/
*.py[cod]

# Local secrets and environment files
backend/.env

# Local source corpus and generated vector database
backend/data/
backend/chroma_db/

# Local model/cache files
.cache/
*.sqlite3
# Cached OCR text (regenerated automatically)
backend/ocr_cache/

# Generated keyword index
backend/bm25_index.pkl

# Local index state. This records which PDFs are in THIS machine's
# chroma_db, and chroma_db itself is not committed. Committing it would
# make a fresh clone skip ingestion and end up with an empty index.
backend/processed_files.json

# Cached GeM responses. Regenerated on demand, and they go stale.
backend/gem_cache/

# HTML saved by "gem search --dump" while tuning the page parser.
*.html
!frontend/index.html

# IndicLID model weights - 250 MB to 1.1 GB each, far over GitHub's 100 MB
# file limit. Download them separately (see backend/.env.example).
backend/indiclid/deployement/working/models/
