# ---------------------------------------------------------------
# Repository-wide ignores. Each sub-project (rag/, scraper/) also
# has its own .gitignore for things specific to it.
# ---------------------------------------------------------------

# Secrets - a catch-all safety net. .env.example is still tracked,
# because this pattern matches ".env" exactly, not ".env.example".
.env
*.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local generated data and downloaded artifacts
*.db
*.sqlite
*.sqlite3
*.log
*.pdf
*.bak
*.orig

# Project-specific runtime outputs
scraper/downloads/
scraper/selected_standards/
scraper/state/
scraper/logs/
collector/**/downloads/
collector/**/state/
collector/**/logs/

# Node / frontend build artifacts
node_modules/
dist/
build/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
