# ---------------------------------------------------------------
# Repository-wide ignores. Each sub-project (rag/, scraper/) also
# has its own .gitignore for things specific to it.
# ---------------------------------------------------------------

# Secrets - a catch-all safety net. .env.example is still tracked,
# because this pattern matches ".env" exactly, not ".env.example".
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Backup copies made while refactoring
*.bak
*.orig

# Local working notes and generated outputs
Claude outputs/
structure.txt

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Source data delivered as an archive. Extract it into the folder that
# uses it - a zip in git is a blob nobody can diff or review.
*.zip
*.7z
*.rar
