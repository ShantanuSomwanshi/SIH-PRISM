# SIH-PRISM BIS Scraper Configuration
# Copy this file to .env and update values as needed

# Database Configuration
DATABASE_URL=sqlite:///./bis_monitor.db

# URLs to Monitor
MONITORED_URL=https://standards.bis.gov.in/website/revised-standards

# Scraper Configuration
SCRAPER_SCRIPT=legacy_scraper/download_standards.py
SCRAPER_CWD=legacy_scraper
SCRAPER_INPUT_FILE=legacy_scraper/Book 2.xlsx
SCRAPER_OUTPUT_DIR=downloads
SELECTED_STANDARDS_DIR=selected_standards
STATE_DIR=state
LOG_DIR=logs
LOCK_FILE=state/change_detector.lock

# Timing Configuration
CHECK_INTERVAL_HOURS=1
REQUEST_TIMEOUT_SECONDS=45
SCRAPER_TIMEOUT_SECONDS=3600

# Retry Configuration
RETRIES=3
RETRY_BASE_SECONDS=10

# ============================================================================
# DUAL-SOURCE CONFIGURATION (Merged Version)
# Enable/disable data sources for flexibility
# ============================================================================

# Enable BIS Revised Standards API as primary source
API_ENABLED=true

# Enable legacy scraper as secondary source
SCRAPER_ENABLED=true

# Enable discovery of standards from pages
DISCOVERY_ENABLED=true

# Automatically fallback to scraper if API fails
FALLBACK_ON_API_FAILURE=true

# Merge duplicate standards from multiple sources
MERGE_DUPLICATE_STANDARDS=true

# ============================================================================
# PII PROTECTION CONFIGURATION (Merged Version)
# Automatic redaction of personal/sensitive data
# ============================================================================

# Automatically redact personal identifiable information
REDACT_PII=true

# Enable PII pattern detection (emails, phones, addresses)
PII_DETECTION_ENABLED=true

# ============================================================================
# WHAT'S NEW DETECTOR CONFIGURATION (NEW - V2.0)
# Monitor BIS "What's New" page for latest updates
# Source: https://www.bis.gov.in/whats-new/?lang=en
# ============================================================================

# Enable What's New detector to track latest standards
WHATS_NEW_ENABLED=true

# Include archive entries (past What's New items)
WHATS_NEW_INCLUDE_ARCHIVE=true

# Maximum number of archive pages to scan (max 10 recommended)
WHATS_NEW_MAX_PAGES=1
WHATS_NEW_DOWNLOAD_PDFS=false

# Download BIS PDF announcements only when explicitly enabled
WHATS_NEW_DOWNLOAD_PDFS=false

# ============================================================================
# CONFIGURATION PROFILES
# ============================================================================

# Profile 1: Fast & Simple (API-Only, like version 1.0)
# Uncomment to use:
# API_ENABLED=true
# SCRAPER_ENABLED=false
# WHATS_NEW_ENABLED=false

# Profile 2: Complete & Secure (Recommended)
# Uncomment to use:
# API_ENABLED=true
# SCRAPER_ENABLED=true
# FALLBACK_ON_API_FAILURE=true
# MERGE_DUPLICATE_STANDARDS=true
# REDACT_PII=true
# WHATS_NEW_ENABLED=true
# WHATS_NEW_INCLUDE_ARCHIVE=true
# WHATS_NEW_MAX_PAGES=1

# Profile 3: Resilient (No API required)
# Uncomment to use:
# API_ENABLED=false
# SCRAPER_ENABLED=true
# REDACT_PII=true
# WHATS_NEW_ENABLED=true

# ============================================================================
# EXAMPLE: Complete Production Configuration
# ============================================================================

# DATABASE_URL=sqlite:///./bis_monitor.db
# MONITORED_URL=https://standards.bis.gov.in/website/revised-standards
# SCRAPER_SCRIPT=legacy_scraper/download_standards.py
# API_ENABLED=true
# SCRAPER_ENABLED=true
# FALLBACK_ON_API_FAILURE=true
# MERGE_DUPLICATE_STANDARDS=true
# REDACT_PII=true
# PII_DETECTION_ENABLED=true
# WHATS_NEW_ENABLED=true
# WHATS_NEW_INCLUDE_ARCHIVE=true
# WHATS_NEW_MAX_PAGES=1
# CHECK_INTERVAL_HOURS=1
