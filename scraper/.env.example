DATABASE_URL=sqlite:///./bis_monitor.db
MONITORED_URL=https://standards.bis.gov.in/website/revised-standards
SCRAPER_SCRIPT=./legacy_scraper/download_standards.py
SCRAPY_SPIDER=./bis_change_detector/selected_spider.py
SCRAPER_CWD=./legacy_scraper
SCRAPER_INPUT_FILE=./legacy_scraper/Book 2.xlsx
SELECTED_STANDARDS_DIR=./selected_standards
SCRAPER_OUTPUT_DIR=./downloads
STATE_DIR=./state
LOG_DIR=./logs
LOCK_FILE=./state/change_detector.lock
CHECK_INTERVAL_HOURS=1
REQUEST_TIMEOUT_SECONDS=45
SCRAPER_TIMEOUT_SECONDS=3600
RETRIES=3
RETRY_BASE_SECONDS=10
DISCOVERY_ENABLED=true

# Dual-Source Configuration (NEW - Merged Version)
API_ENABLED=true              # Enable BIS API as data source
SCRAPER_ENABLED=true          # Enable legacy scraper as data source
FALLBACK_ON_API_FAILURE=true  # Use scraper if API fails
MERGE_DUPLICATE_STANDARDS=true # Merge standards from both sources

# PII Protection (NEW - Merged Version)
REDACT_PII=true               # Automatically redact emails, phone numbers
PII_DETECTION_ENABLED=true    # Enable PII detection in artifacts

# What's New lifecycle monitoring
WHATS_NEW_ENABLED=true
WHATS_NEW_INCLUDE_ARCHIVE=true
WHATS_NEW_MAX_PAGES=1
# Keep false for discovery-only mode; enable only for controlled BIS PDF retrieval
WHATS_NEW_DOWNLOAD_PDFS=false
